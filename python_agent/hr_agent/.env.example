# GigaChat Authorization key (Base64 client_id:client_secret из личного кабинета)
GIGACHAT_AUTH_KEY=

# GigaChat scope (GIGACHAT_API_PERS / GIGACHAT_API_B2B / GIGACHAT_API_CORP)
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель (GigaChat / GigaChat-Pro / GigaChat-Max)
GIGACHAT_MODEL=GigaChat

# Использовать мок вместо реального API (true/false)
USE_MOCK=true
